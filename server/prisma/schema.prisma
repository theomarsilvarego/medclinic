generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Profile {
  ADMINISTRADOR
  MEDICO
  SECRETARIA
}

model User {
  id             Int             @id @default(autoincrement())
  fullName       String          @map("full_name") @db.VarChar(160)
  login          String          @unique @db.VarChar(160)
  passwordHash   String          @map("password_hash") @db.VarChar(255)
  profile        Profile
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  medicalRecords      MedicalRecord[]           @relation("MedicalRecordAuthor")
  uploadedAttachments MedicalRecordAttachment[] @relation("MedicalRecordAttachmentUploader")
  examGroups          ExamGroup[]               @relation("ExamGroupAuthor")
  examRequests        ExamRequest[]             @relation("ExamRequestAuthor")
  injectableRequests  InjectableRequest[]      @relation("InjectableRequestAuthor")
  procedureRequests   ProcedureRequest[]       @relation("ProcedureRequestAuthor")
  ultrasoundRequests  UltrasoundRequest[]      @relation("UltrasoundRequestAuthor")
  uploadedCertificates DigitalCertificate[]    @relation("DigitalCertificateUploader")
  appointmentAttachments AppointmentAttachment[] @relation("AppointmentAttachmentUploader")
  heldCertificates DigitalCertificate[] @relation("DigitalCertificateHolder")
  issuedClinicalDocuments ClinicalDocument[] @relation("ClinicalDocumentIssuer")
  cancelledClinicalDocuments ClinicalDocument[] @relation("ClinicalDocumentCanceller")
  medicationCatalogItems MedicationCatalogItem[]

  @@map("users")
}

model Clinic {
  id        Int      @id @default(autoincrement())
  legalName String   @map("legal_name") @db.VarChar(180)
  tradeName String   @map("trade_name") @db.VarChar(180)
  cnpj      String   @db.VarChar(18)
  cnae      String   @db.VarChar(20)
  address   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinics")
}

model Doctor {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name") @db.VarChar(160)
  crm       String   @db.VarChar(40)
  rqe       String   @db.VarChar(40)
  specialty String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  digitalCertificates DigitalCertificate[]
  clinicalDocuments ClinicalDocument[]

  @@map("doctors")
}

model Insurance {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(160)
  ans       String   @db.VarChar(40)
  value     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attendances  Attendance[]
  appointments Appointment[]

  @@map("insurances")
}

model Procedure {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(160)
  type      ProcedureType?
  value     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  requests    ProcedureRequest[]

  @@map("procedures")
}

enum ProcedureType {
  DIAGNOSTICO_POR_IMAGEM
  ESTETICO
  CIRURGICO
  CONTRACEPTIVO
}

enum InjectableType {
  VITAMINAS
  PROTOCOLOS
  IMUNIDADES
}

model Injectable {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(160)
  type          InjectableType
  supplier      String         @db.VarChar(160)
  expirationDate DateTime?      @map("expiration_date") @db.Date
  lot           String?         @db.VarChar(100)
  unit          String?         @db.VarChar(40)
  invoiceValue  Decimal        @map("invoice_value") @db.Decimal(10, 2)
  value         Decimal        @db.Decimal(10, 2)
  quantity      Int            @default(0)
  minimum       Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  requests      InjectableRequest[]
  appointments  Appointment[]

  @@index([type])
  @@index([name])
  @@map("injectables")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(160)
  cnpj      String   @db.VarChar(18)
  legalName String   @map("legal_name") @db.VarChar(180)
  email     String   @db.VarChar(180)
  contact   String   @db.VarChar(80)
  address   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([cnpj])
  @@map("suppliers")
}

model ExamType {
  id           Int      @id @default(autoincrement())
  code         String   @db.VarChar(40)
  name         String   @db.VarChar(160)
  invoiceValue Decimal  @map("invoice_value") @db.Decimal(10, 2)
  value        Decimal  @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  groupItems   ExamGroupItem[]

  @@index([code])
  @@index([name])
  @@map("exam_types")
}

model ExamGroup {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(160)
  createdById Int             @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  createdBy   User            @relation("ExamGroupAuthor", fields: [createdById], references: [id], onUpdate: Cascade, onDelete: Restrict)
  items       ExamGroupItem[]
  requests    ExamRequest[]

  @@index([createdById])
  @@index([name])
  @@map("exam_groups")
}

model ExamGroupItem {
  id          Int       @id @default(autoincrement())
  groupId     Int       @map("group_id")
  examTypeId  Int       @map("exam_type_id")
  group       ExamGroup @relation(fields: [groupId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  examType    ExamType  @relation(fields: [examTypeId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([groupId, examTypeId])
  @@index([examTypeId])
  @@map("exam_group_items")
}

model Patient {
  id             Int             @id @default(autoincrement())
  sourceCode     Int?            @unique @map("source_code")
  recordNumber   String?         @map("record_number") @db.VarChar(40)
  fullName       String          @map("full_name") @db.VarChar(180)
  sex            Int?
  maritalStatus  Int?            @map("marital_status")
  cpf            String?         @db.VarChar(14)
  email          String?         @db.VarChar(180)
  phone          String?         @db.VarChar(40)
  birthDate      DateTime?       @map("birth_date") @db.Date
  insuranceCode  Int?            @map("insurance_code")
  notes          String?         @db.Text
  allergies      String?         @db.Text
  comorbidities  String?         @db.Text
  medicationsInUse String?       @map("medications_in_use") @db.Text
  photoStorageKey String?        @map("photo_storage_key") @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  appointments           Appointment[]
  medicalRecords         MedicalRecord[]
  recordAttachments     MedicalRecordAttachment[]
  examRequests          ExamRequest[]
  injectableRequests    InjectableRequest[]
  procedureRequests     ProcedureRequest[]
  ultrasoundRequests    UltrasoundRequest[]
  appointmentAttachments AppointmentAttachment[]
  anamneses             PatientAnamnesis[]
  clinicalDocuments     ClinicalDocument[]
  crmTreatments         CrmTreatment[]

  @@index([fullName])
  @@index([cpf])
  @@map("patients")
}

model Attendance {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(160)
  value        Decimal       @db.Decimal(10, 2)
  insuranceId  Int           @map("insurance_id")
  active       Boolean       @default(true)
  insurance    Insurance     @relation(fields: [insuranceId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  appointments Appointment[]

  @@index([insuranceId])
  @@map("attendances")
}

enum AppointmentStatus {
  AGENDADO
  CONFIRMADO
  EM_ATENDIMENTO
  ATENDIDO
  FALTOU
}

enum AppointmentItemType {
  ATENDIMENTO
  PROCEDIMENTO
  INJETAVEL
  COLETA
}

model Appointment {
  id              Int                 @id @default(autoincrement())
  appointmentDate DateTime            @map("appointment_date") @db.Date
  scheduledTime   String              @map("scheduled_time") @db.VarChar(5)
  patientId       Int                 @map("patient_id")
  doctorId        Int                 @map("doctor_id")
  insuranceId     Int                 @map("insurance_id")
  itemType        AppointmentItemType @map("item_type")
  attendanceId    Int?                @map("attendance_id")
  procedureId     Int?                @map("procedure_id")
  injectableId    Int?                @map("injectable_id")
  status          AppointmentStatus   @default(AGENDADO)
  notes           String?             @db.Text
  patient         Patient             @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  doctor          Doctor              @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  insurance       Insurance           @relation(fields: [insuranceId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  attendance      Attendance?         @relation(fields: [attendanceId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  procedure       Procedure?          @relation(fields: [procedureId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  injectable      Injectable?         @relation(fields: [injectableId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  medicalRecords  MedicalRecord[]
  clinicalDocuments ClinicalDocument[]
  attachments     AppointmentAttachment[]
  anamnesis       PatientAnamnesis?

  @@unique([doctorId, appointmentDate, scheduledTime])
  @@index([appointmentDate, scheduledTime])
  @@index([patientId, appointmentDate])
  @@map("appointments")
}

model PatientAnamnesis {
  id                Int          @id @default(autoincrement())
  appointmentId     Int          @unique @map("appointment_id")
  patientId         Int          @map("patient_id")
  tokenHash         String       @unique @map("token_hash") @db.VarChar(64)
  answers           Json?
  consentAcceptedAt DateTime?    @map("consent_accepted_at") @db.DateTime(3)
  consentVersion    String?      @map("consent_version") @db.VarChar(40)
  submittedAt       DateTime?    @map("submitted_at") @db.DateTime(3)
  expiresAt         DateTime     @map("expires_at") @db.DateTime(3)
  revokedAt         DateTime?    @map("revoked_at") @db.DateTime(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  patient           Patient      @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([patientId, submittedAt])
  @@map("patient_anamneses")
}

model MedicalRecord {
  id             Int          @id @default(autoincrement())
  patientId      Int          @map("patient_id")
  authorId       Int          @map("author_id")
  appointmentId  Int?         @map("appointment_id")
  recordDate     DateTime     @map("record_date") @db.Date
  title          String       @db.VarChar(160)
  conduct        String?      @db.Text
  patient        Patient      @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  author         User         @relation("MedicalRecordAuthor", fields: [authorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  attachments    MedicalRecordAttachment[]
  examRequests   ExamRequest[]
  injectableRequests InjectableRequest[]
  procedureRequests ProcedureRequest[]
  ultrasoundRequests UltrasoundRequest[]
  clinicalDocuments ClinicalDocument[]

  @@index([patientId, recordDate])
  @@index([authorId, recordDate])
  @@index([appointmentId])
  @@map("medical_records")
}

enum ExamRequestStatus {
  AGUARDANDO_RESULTADO
}

enum RequestBillingStatus {
  A_FATURAR
  FATURADO
}

enum RequestSchedulingStatus {
  NAO_AGENDADO
  AGENDADO
}

model ExamRequest {
  id             Int               @id @default(autoincrement())
  medicalRecordId Int              @map("medical_record_id")
  patientId      Int               @map("patient_id")
  examGroupId    Int               @map("exam_group_id")
  examTypeIds    Json?             @map("exam_type_ids")
  code           String            @unique @db.VarChar(20)
  groupName      String            @map("group_name") @db.VarChar(160)
  status         ExamRequestStatus @default(AGUARDANDO_RESULTADO)
  billingStatus  RequestBillingStatus @default(A_FATURAR) @map("billing_status")
  schedulingStatus RequestSchedulingStatus @default(NAO_AGENDADO) @map("scheduling_status")
  pdfUrl         String?           @map("pdf_url") @db.VarChar(255)
  requestedById  Int               @map("requested_by_id")
  requestedAt    DateTime          @default(now()) @map("requested_at")
  medicalRecord  MedicalRecord     @relation(fields: [medicalRecordId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  patient        Patient           @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  examGroup      ExamGroup         @relation(fields: [examGroupId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  requestedBy    User              @relation("ExamRequestAuthor", fields: [requestedById], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([medicalRecordId, examGroupId])
  @@index([patientId])
  @@index([requestedById])
  @@map("exam_requests")
}

enum UltrasoundRequestType {
  MAMAS
  TRANSVAGINAL_ROTINA
  TRANSVAGINAL_PREPARO
}

enum UltrasoundRequestStatus {
  AGUARDANDO_RESULTADO
}

model UltrasoundRequest {
  id              Int                     @id @default(autoincrement())
  medicalRecordId Int                     @map("medical_record_id")
  patientId       Int                     @map("patient_id")
  type            UltrasoundRequestType
  description     String?                 @db.Text
  code            String                  @unique @db.VarChar(20)
  status          UltrasoundRequestStatus @default(AGUARDANDO_RESULTADO)
  billingStatus   RequestBillingStatus @default(A_FATURAR) @map("billing_status")
  schedulingStatus RequestSchedulingStatus @default(NAO_AGENDADO) @map("scheduling_status")
  pdfUrl          String?                 @map("pdf_url") @db.VarChar(255)
  requestedById   Int                     @map("requested_by_id")
  requestedAt     DateTime                @default(now()) @map("requested_at")
  medicalRecord   MedicalRecord           @relation(fields: [medicalRecordId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  patient         Patient                 @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  requestedBy     User                    @relation("UltrasoundRequestAuthor", fields: [requestedById], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([medicalRecordId, type])
  @@index([patientId])
  @@index([requestedById])
  @@map("ultrasound_requests")
}

enum InjectableRequestRoute {
  IM
  EV
  SC
}

enum InjectableRequestStatus {
  AGUARDANDO_APLICACAO
}

model InjectableRequest {
  id              Int                     @id @default(autoincrement())
  medicalRecordId Int                     @map("medical_record_id")
  patientId       Int                     @map("patient_id")
  injectableId    Int                     @map("injectable_id")
  name            String                  @db.VarChar(160)
  category        InjectableType
  route           InjectableRequestRoute
  sessions        Int                     @default(1)
  observation     String?                 @db.Text
  status          InjectableRequestStatus @default(AGUARDANDO_APLICACAO)
  billingStatus   RequestBillingStatus @default(A_FATURAR) @map("billing_status")
  schedulingStatus RequestSchedulingStatus @default(NAO_AGENDADO) @map("scheduling_status")
  requestedById   Int                     @map("requested_by_id")
  requestedAt     DateTime                @default(now()) @map("requested_at")
  medicalRecord   MedicalRecord           @relation(fields: [medicalRecordId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  patient         Patient                 @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  injectable      Injectable              @relation(fields: [injectableId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  requestedBy     User                    @relation("InjectableRequestAuthor", fields: [requestedById], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([medicalRecordId, injectableId])
  @@index([patientId])
  @@index([requestedById])
  @@map("injectable_requests")
}

model MedicalRecordAttachment {
  id              Int          @id @default(autoincrement())
  medicalRecordId Int          @map("medical_record_id")
  patientId       Int          @map("patient_id")
  fileName        String       @map("file_name") @db.VarChar(255)
  mimeType        String       @map("mime_type") @db.VarChar(100)
  sizeBytes       Int          @map("size_bytes")
  storageKey      String       @unique @map("storage_key") @db.VarChar(255)
  url             String       @db.VarChar(255)
  uploadedById    Int          @map("uploaded_by_id")
  uploadedAt      DateTime     @default(now()) @map("uploaded_at")
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  uploadedBy      User         @relation("MedicalRecordAttachmentUploader", fields: [uploadedById], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([medicalRecordId])
  @@index([patientId])
  @@index([uploadedById])
  @@map("medical_record_attachments")
}

model AppointmentAttachment {
  id              Int          @id @default(autoincrement())
  appointmentId   Int          @map("appointment_id")
  patientId       Int          @map("patient_id")
  fileName        String       @map("file_name") @db.VarChar(255)
  mimeType        String       @map("mime_type") @db.VarChar(100)
  examType        String?      @map("exam_type") @db.VarChar(40)
  examDate        DateTime?    @map("exam_date") @db.Date
  sizeBytes       Int          @map("size_bytes")
  storageKey      String       @unique @map("storage_key") @db.VarChar(255)
  url             String       @db.VarChar(255)
  uploadedById    Int          @map("uploaded_by_id")
  uploadedAt      DateTime     @default(now()) @map("uploaded_at")
  appointment     Appointment  @relation(fields: [appointmentId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  uploadedBy      User         @relation("AppointmentAttachmentUploader", fields: [uploadedById], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([appointmentId])
  @@index([patientId])
  @@index([uploadedById])
  @@map("appointment_attachments")
}

enum ProcedureRequestStatus {
  AGUARDANDO_AGENDAMENTO
}

model ProcedureRequest {
  id              Int                   @id @default(autoincrement())
  medicalRecordId Int                   @map("medical_record_id")
  patientId       Int                   @map("patient_id")
  procedureId     Int                   @map("procedure_id")
  name            String                @db.VarChar(160)
  value           Decimal               @db.Decimal(10, 2)
  status          ProcedureRequestStatus @default(AGUARDANDO_AGENDAMENTO)
  billingStatus   RequestBillingStatus @default(A_FATURAR) @map("billing_status")
  schedulingStatus RequestSchedulingStatus @default(NAO_AGENDADO) @map("scheduling_status")
  requestedById   Int                   @map("requested_by_id")
  requestedAt     DateTime              @default(now()) @map("requested_at")
  medicalRecord   MedicalRecord         @relation(fields: [medicalRecordId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  patient         Patient               @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  procedure       Procedure             @relation(fields: [procedureId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  requestedBy     User                  @relation("ProcedureRequestAuthor", fields: [requestedById], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([medicalRecordId, procedureId])
  @@index([patientId])
  @@index([requestedById])
  @@map("procedure_requests")
}

enum CrmCategory {
  VACINAS
  VITAMINAS
  PROTOCOLOS
  MEDICACOES
  LASER_INTIMO
  CLAREAMENTO_INTIMO
  MANUTENCAO_LASER
}

enum CrmStatus {
  INICIADO
  EM_ANDAMENTO
  CONCLUIDO
}

enum CrmProductType {
  INJETAVEL
  PROCEDIMENTO
}

model CrmTreatment {
  id            Int            @id @default(autoincrement())
  patientId     Int            @map("patient_id")
  productType   CrmProductType  @map("product_type")
  productId     Int            @map("product_id")
  productName   String         @map("product_name") @db.VarChar(160)
  category      CrmCategory
  status        CrmStatus       @default(INICIADO)
  observation   String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  patient       Patient         @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  doses         CrmDose[]

  @@index([patientId])
  @@index([status])
  @@map("crm_treatments")
}

model CrmDose {
  id          Int          @id @default(autoincrement())
  treatmentId Int          @map("treatment_id")
  doseDate    DateTime     @map("dose_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  treatment   CrmTreatment @relation(fields: [treatmentId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([treatmentId, doseDate])
  @@map("crm_doses")
}


model DigitalCertificate {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(160)
  fileName          String   @map("file_name") @db.VarChar(255)
  subject           String?  @db.VarChar(255)
  issuer            String?  @db.VarChar(255)
  serialNumber      String?  @map("serial_number") @db.VarChar(255)
  validFrom         DateTime? @map("valid_from")
  validTo           DateTime? @map("valid_to")
  pfxEncrypted      String   @map("pfx_encrypted") @db.LongText
  passwordEncrypted String   @map("password_encrypted") @db.Text
  active            Boolean  @default(true)
  doctorId          Int?     @map("doctor_id")
  assignedUserId    Int?     @map("assigned_user_id")
  uploadedById      Int      @map("uploaded_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  uploadedBy        User     @relation("DigitalCertificateUploader", fields: [uploadedById], references: [id], onUpdate: Cascade, onDelete: Restrict)
  doctor            Doctor?  @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  assignedUser      User?    @relation("DigitalCertificateHolder", fields: [assignedUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  clinicalDocuments ClinicalDocument[]

  @@index([active])
  @@index([doctorId, active])
  @@index([assignedUserId, active])
  @@map("digital_certificates")
}


model MedicationCatalogItem {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(180)
  presentation String   @db.VarChar(180)
  active       Boolean  @default(true)
  controlled   Boolean  @default(false)
  createdById  Int      @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    User     @relation(fields: [createdById], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([name, presentation])
  @@index([active, controlled, name])
  @@map("medication_catalog_items")
}

enum ClinicalDocumentType {
  RECEITA
  ATESTADO
}

enum ClinicalDocumentStatus {
  EMITIDO
  CANCELADO
}

model ClinicalDocument {
  id                     Int                    @id @default(autoincrement())
  documentNumber         String?                @unique @map("document_number") @db.VarChar(32)
  validationCode         String                 @unique @map("validation_code") @db.VarChar(64)
  type                   ClinicalDocumentType
  subtype                String                 @db.VarChar(40)
  status                 ClinicalDocumentStatus @default(EMITIDO)
  content                Json
  pdfStorageKey          String                 @unique @map("pdf_storage_key") @db.VarChar(255)
  cidAuthorizedAt        DateTime?              @map("cid_authorized_at") @db.DateTime(3)
  issuedAt               DateTime               @default(now()) @map("issued_at") @db.DateTime(3)
  medicalRecordId        Int                    @map("medical_record_id")
  appointmentId          Int                    @map("appointment_id")
  patientId              Int                    @map("patient_id")
  doctorId               Int                    @map("doctor_id")
  issuedById             Int                    @map("issued_by_id")
  signatureCertificateId Int                    @map("signature_certificate_id")
  cancelledAt            DateTime?              @map("cancelled_at") @db.DateTime(3)
  cancelledById          Int?                   @map("cancelled_by_id")
  cancellationReason     String?                @map("cancellation_reason") @db.Text
  medicalRecord          MedicalRecord          @relation(fields: [medicalRecordId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  appointment            Appointment            @relation(fields: [appointmentId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  patient                Patient                @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  doctor                 Doctor                 @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  issuedBy               User                   @relation("ClinicalDocumentIssuer", fields: [issuedById], references: [id], onUpdate: Cascade, onDelete: Restrict)
  cancelledBy            User?                  @relation("ClinicalDocumentCanceller", fields: [cancelledById], references: [id], onUpdate: Cascade, onDelete: Restrict)
  signatureCertificate   DigitalCertificate    @relation(fields: [signatureCertificateId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([medicalRecordId, issuedAt])
  @@index([appointmentId, issuedAt])
  @@index([patientId, issuedAt])
  @@index([doctorId, issuedAt])
  @@map("clinical_documents")
}
