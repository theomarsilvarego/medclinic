generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Profile {
  ADMINISTRADOR
  MEDICO
  SECRETARIA
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name") @db.VarChar(160)
  login        String   @unique @db.VarChar(160)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  profile      Profile
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Clinic {
  id        Int      @id @default(autoincrement())
  legalName String   @map("legal_name") @db.VarChar(180)
  tradeName String   @map("trade_name") @db.VarChar(180)
  cnpj      String   @db.VarChar(18)
  cnae      String   @db.VarChar(20)
  address   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinics")
}

model Doctor {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name") @db.VarChar(160)
  crm       String   @db.VarChar(40)
  rqe       String   @db.VarChar(40)
  specialty String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("doctors")
}

model Insurance {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(160)
  ans       String   @db.VarChar(40)
  value     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("insurances")
}

model Procedure {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(160)
  value     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("procedures")
}

model Patient {
  id            Int       @id @default(autoincrement())
  sourceCode    Int       @unique @map("source_code")
  recordNumber  String?   @map("record_number") @db.VarChar(40)
  fullName      String    @map("full_name") @db.VarChar(180)
  sex           Int?
  maritalStatus Int?      @map("marital_status")
  cpf           String?   @db.VarChar(14)
  email         String?   @db.VarChar(180)
  phone         String?   @db.VarChar(40)
  birthDate     DateTime? @map("birth_date") @db.Date
  insuranceCode Int?      @map("insurance_code")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([fullName])
  @@index([cpf])
  @@map("patients")
}
